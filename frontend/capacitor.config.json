{
  "appId": "io.github.vandrovisky.opengymn",
  "appName": "openGym-N",
  "webDir": "dist",
  "backgroundColor": "#000000",
  "android": {
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable"
    },
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": true,
      "launchFadeOutDuration": 180,
      "backgroundColor": "#000000",
      "showSpinner": false
    }
  }
}
